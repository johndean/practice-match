# Practice Match — service variables. Real values live only in Railway (per service,
# per environment) and are set out-of-band. Never commit real values.
DATABASE_URL=postgresql://pm:pm_dev_pw@localhost:5433/practice_match   # Railway: ${{PostGIS.DATABASE_PRIVATE_URL}}
REDIS_URL=redis://localhost:6380/0                                      # Railway: ${{Redis.REDIS_URL}}
ENVIRONMENT=qa                                                          # qa | production | test — also drives VITE_ENVIRONMENT at image build
API_SECRET_KEY=change_me                                                # openssl rand -hex 32; different per environment
ALLOWED_ORIGINS=https://qa.foundation.vin                              # comma-separated CORS allowlist
COMMIT_SHA=dev                                                          # set by scripts/deploy.sh at deploy time; leave as dev locally
PUBLIC_INDEXING=false                                                   # QA leaves this unset/false (noindex); production runs true
SITE_MODE=app                                                            # app | coming_soon — production runs coming_soon until launch (QA never does)
HIBP_ENABLED=true                                                         # Have I Been Pwned k-anonymity password screen; false falls straight to the bundled offline list
MARKET_DATA_PUBLIC=false                                                  # anonymous visitors gain market.read only while true — QA evaluation only, never production
CONSOLIDATOR_KEYWORDS=                                                    # comma-separated employer-domain keywords (VIN Foundation-supplied); an application-review hint only, default empty
LINK_BASE_URL=https://qa.foundation.vin                                   # origin the verify/reset links in transactional email point at; production sets https://foundation.vin
EMAIL_ALLOWLIST=                                                          # comma-separated addresses/domains transactional email may be delivered to; empty means no allowlist
# CENSUS_API_KEY=                                                       # worker only, Sub-project 3; John holds the key — never in git, chat, or CI
